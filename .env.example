# Copy to .env (git-ignored) and fill in. PULSAR loads it from the project root
# on every run; a variable already set in your shell always wins over this file.
# The variable NAMES are declared in config/default.toml; only values live here.
# Never commit real values.

# Authenticated SIGAA: discovery, application-state sync, explicit application.
# Username is the CPF as SIGAA expects it.
UFAL_SIGAA_USERNAME=
UFAL_SIGAA_PASSWORD=

# SMTP delivery. UFAL is on Google Workspace, so this must be a 16-character
# Google App Password (accounts.google.com -> Security -> App passwords), not
# your account password, and PULSAR_SMTP_USER must equal the [smtp].from_address
# set in config/local.toml.
PULSAR_SMTP_USER=
PULSAR_SMTP_PASSWORD=
